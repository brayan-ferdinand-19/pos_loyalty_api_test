{
  "info": {
    "name": "POS Orders & Customer Loyalty API",
    "description": "API collection for the 5 mandatory endpoints in POS Orders & Loyalty system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Create Product (POST /api/v1/products)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Notebook A5\",\n  \"code\": \"PRD001\",\n  \"unitPrice\": 350.00,\n  \"availableQuantity\": 100,\n  \"categoryId\": 1,\n  \"active\": true\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/products",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "products"]
        }
      }
    },
    {
      "name": "2. Search Products (GET /api/v1/products)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/products?name=pen&minPrice=50&maxPrice=100&categoryId=1",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "products"],
          "query": [
            { "key": "name", "value": "pen" },
            { "key": "minPrice", "value": "50" },
            { "key": "maxPrice", "value": "100" },
            { "key": "categoryId", "value": "1" }
          ]
        }
      }
    },
    {
      "name": "3. Place Multi-Item Order (POST /api/v1/orders)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer\": {\n    \"fullName\": \"Kasun Perera\",\n    \"mobileNumber\": \"0771234567\",\n    \"email\": \"kasun@example.com\"\n  },\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 2,\n      \"quantity\": 3\n    }\n  ]\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/orders",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "orders"]
        }
      }
    },
    {
      "name": "4. Get Loyalty Customer (GET /api/v1/loyalty-customers)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/loyalty-customers?mobileNumber=0771234567",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "loyalty-customers"],
          "query": [
            { "key": "mobileNumber", "value": "0771234567" }
          ]
        }
      }
    },
    {
      "name": "5. Daily Sales Summary (GET /api/v1/sales/summary)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:8000/api/v1/sales/summary?date=2026-10-22",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "8000",
          "path": ["api", "v1", "sales", "summary"],
          "query": [
            { "key": "date", "value": "2026-10-22" }
          ]
        }
      }
    }
  ]
}
